# Production requires externally issued RS256/ES256 JWTs with tenant_id and
# pipemind_roles claims. A reverse-proxy/IdP must terminate TLS.
PIPEMIND_JWT_ISSUER=https://auth.example.com/
PIPEMIND_JWT_AUDIENCE=pipemind-api
PIPEMIND_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Never set PIPEMIND_DEV_TOKEN in production.
