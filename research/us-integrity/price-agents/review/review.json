  "decisions": [
    {
      "id": "RUNTIME",
      "decision": "accepted_with_limits",
      "artifact": "research/us-integrity/price-agents/runtime/agent_runtime.py",
      "reason": "Durable local orchestration, charged attempts, leases, immutable results, artifact checks and independent-labelled review function as tested. Not authenticated independent people, LLM execution, distributed service or global external-request enforcement."
    },
    {
      "id": "TRACER",
      "decision": "accepted_with_limits",
      "artifact": "research/us-integrity/price-agents/tracing/trace_links.py",
      "reason": "Bounded URL/redirect/DNS/TLS/robots policies and synthetic traversal tested. Final live run failed at DNS: zero HTTP and zero documents. No runtime reservation bridge exists."
    },
    {
      "id": "RECURRENCE",
      "decision": "accepted_with_limits",
      "artifact": "research/us-integrity/price-agents/analysis/recurrence.py",
      "reason": "Exploratory qualified-line screen; independent exact arithmetic and negative-net counterexample passed. Declared source independence and identity require review. No real repeated premium or causal inference."
    },
    {
      "id": "PILOT",
      "decision": "accepted_limited_observations",
      "artifact": "research/us-integrity/investigations/federal-price-pilot-2026-10-30/line_observations.json",
      "reason": "30 incomplete sampled awards and two original DLA CLINs retained. Exact two-record official spotchecks match. DLA line math reconciles; no independent comparator, invoice/payment or benefit established."
    },
    {
      "id": "PARTIES",
      "decision": "accepted_limited_observations",
      "artifact": "research/us-integrity/investigations/federal-price-pilot-2026-10-30/parties/graph.json",
      "reason": "Exact CAGE/UEI joins and intended manufacturer scope preserved; dated reported parent is not beneficial ownership. Printed officer role restricted to one instrument; price selection/payment/benefit unknown. Same-name state candidate remains unmerged."
    },
    {
      "id": "SPEC",
      "decision": "accepted_adapter_acquisition_unresolved",
      "artifact": "research/us-integrity/investigations/bolt-spec-followup-2026-10-30/parse_publog_export.py",
      "reason": "URL privacy defect corrected and regression passed. Parser retains exact NIIN/reference qualifiers but cannot authenticate sources or qualify prices. Zero exact actual official rows acquired; proposed export query unexecuted."
    },
    {
      "id": "ACTUAL_RUN",
      "decision": "accepted_limited_local_reuse",
      "artifact": "research/us-integrity/price-agents/runs/current-run/export-state.json",
      "reason": "Six local reuse attempts, zero new network calls, four independently reviewed accepted packets, five declared blocked tasks and eleven queued tasks. Original capture hashes/times preserved; no actual-run reopen or deployed worker claim."
    },
    {
      "id": "PLAN_AND_EXTENSION",
      "decision": "accepted_with_limits",
      "artifact": "research/us-integrity/price-agents/plans/current-wave.json",
      "reason": "20-task import/reimport succeeds. Explicit host admission and source contracts reviewed; model assignments/later waves remain plans. Loader only adds price-agents as an approved digest-pinned dependency root; extensions remain under investigations."
    }
  ],
